import { useEffect, useState } from 'react';
import { collection, getDocs } from 'firebase/firestore';
import { signInWithPopup, GoogleAuthProvider, onAuthStateChanged, signOut } from 'firebase/auth';
import { db, auth } from './firebase';
import { Calendar, Plus, Globe, Search, Tag, Share2, Phone, MapPin, LogOut } from 'lucide-react';

export default function App() {
  const [user, setUser] = useState(null);
  const [jobs, setJobs] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const unsubscribe = onAuthStateChanged(auth, (currentUser) => {
      setUser(currentUser);
      if (currentUser) {
        fetchJobs();
      } else {
        setLoading(false);
      }
    });
    return () => unsubscribe();
  }, []);

  async function fetchJobs() {
    try {
      const querySnapshot = await getDocs(collection(db, 'jobs'));
      const jobsData = querySnapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data()
      }));
      setJobs(jobsData);
    } catch (error) {
      console.error("Erro ao carregar obras:", error);
    } finally {
      setLoading(false);
    }
  }

  const handleLogin = async () => {
    const provider = new GoogleAuthProvider();
    try {
      await signInWithPopup(auth, provider);
    } catch (error) {
      console.error("Erro no login:", error);
    }
  };

  if (!user) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-slate-50">
        <div className="bg-white p-8 rounded-2xl shadow-sm text-center max-w-sm w-full border border-slate-100">
          <div className="bg-blue-600 text-white rounded-xl w-16 h-16 flex items-center justify-center font-bold text-3xl mx-auto mb-4">R</div>
          <h1 className="text-2xl font-bold text-slate-800 mb-1">Rendermates <span className="text-blue-500">CRM</span></h1>
          <p className="text-slate-500 text-sm mb-8">Jobs Portfolio & Schedule Master</p>
          <button onClick={handleLogin} className="w-full bg-blue-600 text-white font-semibold py-3 px-4 rounded-xl hover:bg-blue-700 transition-colors">
            Sign in with Google
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-slate-50 p-4 font-sans max-w-md mx-auto relative pb-20">
      
      {/* Botão de Logout de emergência no topo */}
      <button onClick={() => signOut(auth)} className="absolute top-2 right-2 text-slate-400 p-2">
        <LogOut size={16} />
      </button>

      {/* Header Card */}
      <div className="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 mb-4">
        <div className="flex items-center gap-3 mb-4">
          <div className="bg-blue-600 text-white rounded-xl w-12 h-12 flex items-center justify-center font-bold text-xl shadow-sm">
            R
          </div>
          <div>
            <h1 className="text-xl font-bold text-slate-800 leading-tight">Rendermates <span className="text-blue-500">CRM</span></h1>
            <p className="text-slate-500 text-xs font-medium">Jobs Portfolio & Schedule Master</p>
          </div>
        </div>
        
        <div className="flex gap-2">
          <button className="flex-1 border border-blue-200 text-blue-600 bg-blue-50 rounded-xl py-2 px-2 flex items-center justify-center gap-2 font-semibold text-sm">
            <Calendar size={16} className="text-red-500" />
            Booked Calendar (1)
          </button>
          <button className="flex-1 bg-blue-600 text-white rounded-xl py-2 px-2 flex items-center justify-center gap-2 font-semibold text-sm shadow-sm">
            <Plus size={16} />
            New Job
          </button>
        </div>
      </div>

      {/* Lead Sources Tracker */}
      <div className="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 mb-4">
        <div className="flex justify-between items-center mb-4">
          <div className="flex items-center gap-2">
            <Globe size={14} className="text-blue-500" />
            <h2 className="text-slate-600 font-bold text-xs tracking-wider">LEAD SOURCES TRACKER<br/>(WEBSITE & CHANNELS)</h2>
          </div>
          <div className="text-right">
            <span className="text-slate-400 text-xs">Total</span><br/>
            <span className="text-slate-700 font-bold text-xs">Leads: 1</span>
          </div>
        </div>

        <div className="flex flex-wrap gap-2">
          <Badge icon={null} text="All Sources (1)" style="border-blue-500 text-blue-600 bg-blue-50" />
          <Badge icon={<Globe size={12} />} text="Website (Organic): 1" style="border-green-200 text-green-700" />
          <Badge icon={null} text="Instagram: 0" style="border-slate-200 text-pink-600" />
          <Badge icon={null} text="Facebook: 0" style="border-slate-200 text-blue-600" />
          <Badge icon={<Search size={12} />} text="Google Search / Ads: 0" style="border-slate-200 text-orange-500" />
          <Badge icon={<Tag size={12} />} text="Builderscrack: 0" style="border-slate-200 text-red-500" />
          <Badge icon={<Share2 size={12} />} text="Word of Mouth / Referral: 0" style="border-slate-200 text-purple-600" />
          <Badge icon={<Phone size={12} />} text="Direct / Phone / Email: 0" style="border-slate-200 text-slate-500" />
        </div>
      </div>

      {/* Stages Filters */}
      <div className="flex overflow-x-auto gap-2 mb-4 pb-2 hide-scrollbar">
        <StageBadge text="All Stages" count="1" active={true} />
        <StageBadge text="New Lead" count="0" active={false} />
        <StageBadge text="Site Visit Scheduled" count="0" active={false} />
        <StageBadge text="Quote Sent" count="0" active={false} />
      </div>

      {/* Job Card (Mock/Firebase) */}
      <div className="bg-white rounded-2xl p-4 shadow-sm border border-slate-100">
        <div className="flex justify-between items-start mb-2">
          <h3 className="font-bold text-lg text-slate-900">Andy Hickman</h3>
          <span className="bg-blue-100 text-blue-600 text-xs font-bold px-3 py-1 rounded-full">In Progress</span>
        </div>
        
        <div className="inline-flex items-center gap-1 bg-green-50 text-green-600 px-2 py-1 rounded text-xs font-medium mb-3">
          <Globe size={12} />
          Website (Organic)
        </div>

        <div className="flex items-center gap-2 text-slate-500 text-sm mb-3">
          <MapPin size={14} className="text-blue-400" />
          54 Amritsar St, Khandallah
        </div>

        <div className="bg-green-50/50 border border-green-100 rounded-lg p-2 text-xs text-slate-600 flex items-center gap-2 mb-4">
          <Calendar size={14} className="text-green-600" />
          Run: <span className="font-bold text-slate-800">2026-10-20 → 2026-11-20</span>
        </div>

        <div className="flex justify-between text-sm pt-3 border-t border-slate-100">
          <span className="text-slate-500">Contract: <span className="font-bold text-slate-800">$14,322.70</span></span>
          <span className="text-slate-500">Paid: <span className="font-bold text-green-600">$5,012.95</span></span>
        </div>
      </div>

    </div>
  );
}

function Badge({ icon, text, style }) {
  return (
    <div className={`flex items-center gap-1.5 border rounded-full px-3 py-1.5 text-xs font-semibold ${style}`}>
      {icon}
      {text}
    </div>
  );
}

function StageBadge({ text, count, active }) {
  return (
    <div className={`flex flex-col items-center justify-center min-w-[80px] px-3 py-2 rounded-2xl border text-center whitespace-nowrap ${active ? 'bg-blue-600 border-blue-600 text-white shadow-md' : 'bg-white border-slate-200 text-slate-600'}`}>
      <span className="text-xs font-semibold">{text}</span>
      <span className="text-xs font-bold">({count})</span>
    </div>
  );
}
