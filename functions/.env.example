# Non-secret deployment parameters. Do not put service-account keys here.
CALENDAR_SYNC_ENABLED=false
# Empty means no jobs, even when enabled. Start with one fictitious job ID.
CALENDAR_SYNC_JOB_IDS=
GOOGLE_CALENDAR_ID=your-existing-rendermates-jobs-calendar-id
GOOGLE_CALENDAR_WRITER=crm-calendar-writer@rendermates-crm.iam.gserviceaccount.com
